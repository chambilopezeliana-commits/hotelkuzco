# ============================================================================
# PLANTILLA DE ENTORNO DE PRODUCCIÓN — Hotel Kuzco
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo como ".env.production" (ya está en .gitignore).
# 2. Completar TODOS los valores marcados con <...> con datos reales.
# 3. Generar APP_KEY con:  php artisan key:generate --env=production
# 4. Ejecutar seeders con credenciales seguras definidas abajo (SEED_ADMIN_*).
# 5. Ejecutar la aplicación con: php artisan serve --env=production
#    (o configurar el alias de entorno en el servidor: APP_ENV=production)
# NUNCA subir .env.production al repositorio.
# ============================================================================

APP_NAME="Hotel Kuzco"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hotelkuzco.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Fuerza de hashing (por defecto suficiente; subir solo si hay hardware sobrado)
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# LOGGING (producción: sin debug, sin exposición de errores al cliente)
# ----------------------------------------------------------------------------
# "stack" escribe en daily (rotación) y en stderr (útil en contenedores/PM2).
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ----------------------------------------------------------------------------
# BASE DE DATOS (MySQL/MariaDB gestionado)
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_kuzco
DB_USERNAME=<usuario_db>
DB_PASSWORD=<contraseña_db_fuerte>

# ----------------------------------------------------------------------------
# SESIONES ENDURECIDAS
# ----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cifrado del contenido de la sesión en reposo (AES): OBLIGATORIO en producción
SESSION_ENCRYPT=true
# Cookie solo por HTTPS: OBLIGATORIO tras instalar certificado TLS
SESSION_SECURE_COOKIE=true
# Acceso solo vía HTTP (JavaScript no puede leer la cookie): mitigación XSS
SESSION_HTTP_ONLY=true
# Protección CSRF a nivel de cookie
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# ----------------------------------------------------------------------------
# CACHÉ Y COLAS
# ----------------------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database

# ----------------------------------------------------------------------------
# CORREO (transaccional del hotel)
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<smtp.example.com>
MAIL_PORT=587
MAIL_USERNAME=<usuario_smtp>
MAIL_PASSWORD=<contraseña_smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="reservas@hotelkuzco.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# CREDENCIALES DEL ADMINISTRADOR INICIAL (siembra en producción)
# ----------------------------------------------------------------------------
# El seeder SOLO crea el admin si ambas variables están definidas.
# La contraseña debe tener 12+ caracteres: generar una aleatoria y guardarla
# en el gestor de contraseñas, NO reutilizarla.
SEED_ADMIN_NAME="Administrador General"
SEED_ADMIN_EMAIL=<admin@hotelkuzco.com>
SEED_ADMIN_PASSWORD=<contraseña_aleatoria_12+_caracteres>

# ----------------------------------------------------------------------------
# IDENTIDAD DEL HOTEL (config/hotel.php)
# ----------------------------------------------------------------------------
HOTEL_ANTICIPO_PORCENTAJE=30
HOTEL_NOMBRE="Kuzco"
HOTEL_LEMA="Palacio del Emperador"
HOTEL_ESLOGAN="Una estadía de reyes"
HOTEL_DIRECCION="Av. Principal 123, Ciudad"
HOTEL_TELEFONO="+591 700-00000"
HOTEL_WHATSAPP="59170000000"
HOTEL_EMAIL="reservas@hotelkuzco.com"
HOTEL_HORARIO="Recepción abierta 24 horas"
